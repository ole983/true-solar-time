{
  "name": "zhen-app",
  "version": "1.0.0",
  "description": "真太阳时 · 子午流注 Android 壳工程(Capacitor)",
  "private": true,
  "scripts": {
    "copy:web": "node scripts/copy-web.js",
    "sync": "npm run copy:web && npx cap sync android",
    "open:android": "npx cap open android",
    "build:apk": "cd android && gradlew.bat assembleRelease",
    "build:aab": "cd android && gradlew.bat bundleRelease",
    "sign:key": "powershell -ExecutionPolicy Bypass -File scripts/gen-keystore.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/geolocation": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/share": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "typescript": "^7.0.2"
  }
}
