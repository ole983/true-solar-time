<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/values/styles.xml
     深色启动主题,冷启动闪屏与网站底色一致(#070b16),避免白屏 -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:background">#070b16</item>
        <item name="android:windowBackground">@color/appBackground</item>
        <item name="android:statusBarColor">#070b16</item>
        <item name="android:navigationBarColor">#070b16</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!-- 启动屏主题:Core SplashScreen 规范 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#070b16</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_sun</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
